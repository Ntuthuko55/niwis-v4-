# Environment Configuration - Copy to .env and customize

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# Database/Storage
DATA_DIRECTORY=./data
CACHE_BACKEND=memory
CACHE_TTL=3600

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Model Configuration
MAX_FORECAST_STEPS=365
DEFAULT_FORECAST_PERIODS=365
MODEL_CACHE_ENABLED=true

# Performance
CONNECTION_POOL_SIZE=10
MAX_UPLOAD_SIZE_MB=500

# PostgreSQL migration (server-only; leave NIWIS_DB_BACKEND=supabase until
# parity checks pass against the existing REST readers).
NIWIS_DB_BACKEND=supabase
DATABASE_URL=postgresql+psycopg://username:password@db.example.com:5432/postgres
NIWIS_DB_POOL_SIZE=10
NIWIS_DB_MAX_OVERFLOW=10
NIWIS_DB_POOL_TIMEOUT=30
NIWIS_DB_POOL_RECYCLE=1800

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ENV=development
DEBUG=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Keep this server-only. Never put it in frontend/.env or VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NIWIS_SUPABASE_TABLE=niwis_daily_climate_v2
# Cache full province reads in the backend for 15 minutes (seconds).
NIWIS_SUPABASE_CACHE_TTL=900
# Shared five-minute cache for dashboard source reads and packaged datasets.
NIWIS_DASHBOARD_CACHE_TTL=300
# Cache compact successful JSON responses; zero disables this layer.
NIWIS_RESPONSE_CACHE_TTL=30
# Model fitting runs outside the API process. Keep one API worker until job
# and dataset state is moved to shared storage.
NIWIS_TRAINING_WORKERS=1
NIWIS_TRAINING_THREADS=2

NIWIS_SUPABASE_TABLES=meteorological_drought_master,satellite_remote_sensing,hydrological_drought_master
# Drought Monitoring, Hydrological Drought and Satellite Drought read these
# database tables directly. CSV fallback is not supported.
# meteorological_drought_master, hydrological_drought_master, satellite_remote_sensing

# Climate indicator tables, in section order 4.1–4.6. Names must match Supabase exactly.
# This project's streamflow table has a space before _master.
NIWIS_SUPABASE_TABLES_MODULE_2=4_1_temperature_change_master,4_2_wet_dry_spells_master,4_3_mean_annual_precipitation_master,4_4_potential_evaporation_daily_master,4_5_irrigation_demand_daily_master,4_6_streamflow_and_climate_linkage_annual _master
NIWIS_SUPABASE_TABLES_MODULE_3=5_1_primary_satellite_vegetation_variables_sansa_master,5_2_meteorological_drivers_saws_master
# Bounded concurrent reads for the vegetation daily source (4-20).
NIWIS_VEGETATION_DB_WORKERS=16
NIWIS_SUPABASE_TABLES_MODULE_4=6_1_core_rainfall_variables_master,6_2_rainfall_derived_drought_indices_master,runoff_variables_master
# Module 5 dam and reservoir operational source.
NIWIS_SUPABASE_TABLES_MODULE_5=8_1_reservoir_operational_master
# Bounded concurrent reads for the rainfall and runoff daily sources (4-20).
NIWIS_RAINFALL_DB_WORKERS=16
# Runoff Status: daily core table followed by monthly derived indicators.
# This dedicated setting does not change module 4 rainfall or module 5 reservoirs.
NIWIS_SUPABASE_TABLES_RUNOFF=runoff_variables_master,7.2_derived_runoff_indicators_master
NIWIS_RUNOFF_DB_WORKERS=8
NIWIS_SUPABASE_TABLES_MODULE_7=9_1_hydrological_station_master,9_2_catchment_characteristics_master,9_3_sansa_earth_observation_master,11_1_hydrogeological,11.2_recharge_and_discharge,11.3_aquifer_sustainability,12.1_physical_water_quality_master,12.2_chemical_water_quality_master,12.3_biological_water_quality_master,12.4_sansa_water_quality_master
# Section 11 and section 12 can also be overridden independently; each service selects its own numbered entries above by default.
NIWIS_SUPABASE_TABLES_MODULE_11=11_1_hydrogeological,11.2_recharge_and_discharge,11.3_aquifer_sustainability
NIWIS_SUPABASE_TABLES_MODULE_12=12.1_physical_water_quality_master,12.2_chemical_water_quality_master,12.3_biological_water_quality_master,12.4_sansa_water_quality_master
# Bounded concurrent reads for the surface-water daily and satellite sources (4-20).
NIWIS_SURFACE_WATER_DB_WORKERS=16
NIWIS_SUPABASE_TABLES_MODULE_6=10_1_borehole_and_aquifer_master,10_2_recharge_supporting _master
# Bounded concurrent reads for the groundwater long-form and recharge sources (4-20).
NIWIS_GROUNDWATER_DB_WORKERS=16
