# Serve frontend/dist as /srv/niwis/frontend; proxy the existing single API.
# Keep the API and database in nearby regions when choosing a deployment host.
server {
    listen 80;
    server_name _;
    root /srv/niwis/frontend;
    index index.html;
    gzip on;
    gzip_static on;
    gzip_types application/javascript application/json application/geo+json text/css image/svg+xml;
    gzip_min_length 1500;

    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_read_timeout 180s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location ~ ^/(niwis-api|spatial-api|multivariate-api)/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_read_timeout 180s;
        proxy_set_header Host $host;
    }
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location = /south_africa_adm2.display.geojson {
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
